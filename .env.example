# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env

# Koneksi database PostgreSQL
DATABASE_URL=postgres://user:password@host:port/db_name?sslmode=require

# Secret untuk JWT — gunakan string panjang dan acak
JWT_SECRET=ganti_dengan_string_rahasia_panjang_dan_acak

# Port backend server
PORT=8080

# Environment: development | production
APP_ENV=development

# API Key dari Resend (https://resend.com) untuk kirim email reset password
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL frontend (untuk link di email)
FRONTEND_URL=http://localhost:8080

# (Opsional) Override IP untuk QR QRIS — isi IP LAN server jika auto-detect gagal
# QRIS_HOST=192.168.1.xxx
