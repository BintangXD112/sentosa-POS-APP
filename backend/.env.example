# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env

DATABASE_URL=postgres://user:password@host:port/db_name?sslmode=require
JWT_SECRET=ganti_dengan_string_rahasia_panjang_dan_acak
PORT=8080
APP_ENV=development
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FRONTEND_URL=http://localhost:8080

# (Opsional) Override IP untuk QR QRIS — isi IP LAN server jika auto-detect gagal
# QRIS_HOST=192.168.1.xxx
